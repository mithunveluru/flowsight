# PostgreSQL
POSTGRES_PASSWORD=your_secure_password_here

# JWT — generate with: openssl rand -base64 64
JWT_SECRET=your_base64_encoded_256bit_secret_here
# Access token lifetime (ms). Short-lived; sessions persist via refresh tokens.
JWT_EXPIRATION=900000
# Refresh token lifetime (ms), 14 days. Rotated on each use, revoked on logout.
REFRESH_TOKEN_EXPIRATION=1209600000

# CORS
CORS_ALLOWED_ORIGINS=http://localhost:3007

# Frontend
NEXT_PUBLIC_API_URL=http://localhost:8080

# Groq, used for receipt OCR and merchant disambiguation. Leave empty to use Tesseract only.
GROQ_API_KEY=

# ml-service. docker-compose uses a local-only default token and turns the categorizer and OCR on;
# elsewhere an empty token keeps every feature on its rule-based path.
# Generate with: openssl rand -hex 32 (the same value goes to the backend and ml-service).
ML_SERVICE_TOKEN=
# Per-capability switches; all default to false. Capabilities: CATEGORIZER,
# MERCHANT_EMBEDDINGS, RECURRING_SCORER, FORECASTER, OCR, NARRATIVE.
# Set the same switches on the backend and on ml-service; a capability is served only
# when ml-service also has an active model version registered for it.
ML_CATEGORIZER_ENABLED=false
ML_CATEGORIZER_SHADOW=false
ML_MERCHANT_EMBEDDINGS_ENABLED=false
ML_RECURRING_SCORER_ENABLED=false
ML_RECURRING_SCORER_SHADOW=false
# Backend wait for the recurring scorer before it falls back to the rules.
ML_RECURRING_SCORER_TIMEOUT=400ms
ML_OCR_ENABLED=false
# OCR on ml-service can take tens of seconds; it runs outside any database transaction.
ML_OCR_TIMEOUT=60s
# Optional vision-model pass on ml-service OCR. Empty model = pass off; no model name is assumed.
ML_OCR_LLM_ENABLED=false
ML_OCR_LLM_MODEL=
# Tesseract languages for the backend's own OCR. Use eng+ara only if the image has tesseract-ocr-ara.
OCR_TESSERACT_LANGUAGES=eng
# Groq text models for ambiguous receipt merchants, in order of preference. The backend checks them
# against the key's model list and calls the first available one; if none is, the heuristics answer.
GROQ_MERCHANT_MODEL=openai/gpt-oss-20b,llama-3.1-8b-instant
# After a 5xx or connection failure the receipt-ocr service is skipped for this long.
RECEIPT_OCR_BACKOFF=10m

# Merchant resolution. The LLM step only runs for names nothing else could resolve,
# sends redacted text, and is off unless both settings below are set.
MERCHANT_LLM_ENABLED=false
MERCHANT_LLM_MODEL=

# Insight narratives and the Ask FlowSight assistant. Off by default; every answer falls back to
# templates and keyword intents. No model name is assumed: set LLM_MODEL to enable. Any
# OpenAI-compatible endpoint works; LLM_API_KEY defaults to GROQ_API_KEY when unset.
LLM_ENABLED=false
LLM_BASE_URL=https://api.groq.com/openai/v1
LLM_MODEL=
# LLM_API_KEY=
LLM_CONNECT_TIMEOUT_MS=2000
LLM_TIMEOUT_MS=8000
ASSISTANT_RATE_LIMIT_PER_HOUR=30

# Password-reset email. Provider options: gmail, brevo, resend.
#
# gmail: SMTP with an App Password (Google account > Security > 2-Step
# Verification > App passwords). Good for local dev. Does NOT work on hosts
# that block outbound SMTP (e.g. Render free tier).
# Leave MAIL_USERNAME/MAIL_PASSWORD empty to log the reset link instead of sending.
EMAIL_PROVIDER=gmail
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_USERNAME=your_gmail_address@gmail.com
MAIL_PASSWORD=your_16_char_app_password
# Optional: defaults to MAIL_USERNAME. Gmail rejects a From it does not own.
MAIL_FROM=FlowSight <your_gmail_address@gmail.com>
#
# brevo: transactional email over HTTPS (port 443), so it works where SMTP is
# blocked. Verify a single sender in the Brevo dashboard; no domain needed.
# To use it: set EMAIL_PROVIDER=brevo and fill the two vars below.
BREVO_API_KEY=your_brevo_api_key
BREVO_SENDER_EMAIL=your_verified_sender@example.com
FRONTEND_URL=http://localhost:3007
